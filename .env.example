# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (Mistral) ---
LLM_API_KEY=oj2Z...
LLM_MODEL_ID=mistral-medium-latest
LLM_TEMPERATURE=0.0

# --- Embeddings (HuggingFace Inference API — gratuito) ---
# Gere em: https://huggingface.co/settings/tokens → New token → Read
HUGGINGFACE_API_KEY=hf_...
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5

# --- Database (Postgres + pgvector) ---
# Use 'postgres:5432' when running with Docker Compose, 'localhost:5532' when running app on host
DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# --- Knowledge base ---
KNOWLEDGE_TABLE=design_patterns_kb

# --- Pipeline ---
MAX_REFLECTION_ITERATIONS=3
