# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM ---
# Backend: 'mistral' (API online) ou 'ollama' (modelos locais via compose)
LLM_PROVIDER=mistral
LLM_API_KEY=oj2Z...                  # exigido só no modo mistral
LLM_MODEL_ID=mistral-medium-latest   # no modo ollama use, ex.: mistral  ou  qwen2.5
LLM_TEMPERATURE=0.0
LLM_THROTTLE_SECONDS=20              # intervalo mínimo entre chamadas de LLM (free tier); use 0 em conta paga

# Quando LLM_PROVIDER=ollama:
#   http://localhost:11434 ao rodar o app no host; http://ollama:11434 dentro do compose
OLLAMA_BASE_URL=http://localhost:11434
# Tags que o serviço ollama-pull baixa (opcional, ex.: mistral:7b, qwen2.5:7b)
OLLAMA_MISTRAL_MODEL=mistral
OLLAMA_QWEN_MODEL=qwen2.5

# --- Embeddings (HuggingFace Inference API — gratuito) ---
# Gere em: https://huggingface.co/settings/tokens → New token → Read
HUGGINGFACE_API_KEY=hf_...
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5

# --- Database (Postgres + pgvector) ---
# Use 'postgres:5432' when running with Docker Compose, 'localhost:5532' when running app on host
DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# --- Knowledge base ---
KNOWLEDGE_TABLE=design_patterns_kb

# --- Pipeline ---
MAX_REFLECTION_ITERATIONS=3
