# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (Groq + Llama) ---
GROQ_API_KEY=gsk_...
LLM_MODEL_ID=llama-3.3-70b-versatile

# --- Embeddings (HuggingFace Inference API — gratuito) ---
# Gere em: https://huggingface.co/settings/tokens → New token → Read
HUGGINGFACE_API_KEY=hf_...
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5

# --- Database (Postgres + pgvector) ---
DB_URL=postgresql+psycopg://ai:ai@postgres:5432/ai

# --- Knowledge base ---
KNOWLEDGE_TABLE=design_patterns_kb

# --- Pipeline ---
MAX_REFLECTION_ITERATIONS=3
