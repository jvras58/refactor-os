# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (Mistral) ---
MISTRAL_API_KEY=oj2Z...
LLM_MODEL_ID=mistral-medium-latest
LLM_TEMPERATURE=0.0

# --- Database (Postgres) — apenas sessões/traces do Agno; nenhum embedding ---
# Use 'postgres:5432' when running with Docker Compose, 'localhost:5532' when running app on host
DB_URL=postgresql+psycopg://ai:ai@localhost:5532/ai

# --- Pipeline ---
MAX_REFLECTION_ITERATIONS=3
